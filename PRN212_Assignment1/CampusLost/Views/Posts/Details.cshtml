@model LostItemPost
@{
    Layout = null;
    var postedOnVietnam = new DateTimeOffset(DateTime.SpecifyKind(Model.PostedOn, DateTimeKind.Utc)).ToOffset(TimeSpan.FromHours(7));
}
<!DOCTYPE html>

<html lang="vi">
    <head>
        <meta charset="utf-8"/>
        <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
        <meta content="web_standard" name="shell-type"/>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet"/>
        <style>
            @@layer
            base {

                html,
                body {
                    margin: 0;
                    padding: 0;
                }

                body {
                    overscroll-behavior: none;
                }

                main> :first-child {
                    margin-top: 0 !important;
                }

                main> :last-child {
                    margin-bottom: 0 !important;
                }
            }

            ::-webkit-scrollbar {
                display: none;
            }
        </style>
        <script src="https://cdn.tailwindcss.com"></script>
        <script id="tailwind-config">
            tailwind.config = { darkMode: "class", theme: { extend: { "colors": { "surface-container-highest": "#d3e4fe", "on-primary-fixed": "#001551", "surface-bright": "#f8f9ff", "on-primary": "#ffffff", "primary": "#0037b0", "on-error-container": "#93000a", "secondary-fixed": "#ffdbd0", "on-tertiary-fixed-variant": "#005323", "on-tertiary-container": "#88ea9a", "tertiary-container": "#006b2f", "on-surface": "#0b1c30", "primary-fixed": "#dce1ff", "on-tertiary": "#ffffff", "surface-dim": "#cbdbf5", "primary-fixed-dim": "#b7c4ff", "error-container": "#ffdad6", "outline": "#747686", "on-secondary-fixed-variant": "#832600", "primary-container": "#1d4ed8", "secondary-container": "#fd6b36", "tertiary-fixed-dim": "#79db8d", "tertiary": "#005022", "surface-container-low": "#eff4ff", "on-background": "#0b1c30", "surface-container-high": "#dce9ff", "on-secondary-fixed": "#390c00", "secondary-fixed-dim": "#ffb59d", "on-error": "#ffffff", "background": "#f8f9ff", "on-secondary-container": "#5d1900", "surface-container": "#e5eeff", "inverse-on-surface": "#eaf1ff", "inverse-surface": "#213145", "on-primary-container": "#cad3ff", "inverse-primary": "#b7c4ff", "secondary": "#ac3400", "on-tertiary-fixed": "#00210a", "surface": "#f8f9ff", "outline-variant": "#c4c5d7", "on-primary-fixed-variant": "#0039b5", "surface-container-lowest": "#ffffff", "on-secondary": "#ffffff", "surface-tint": "#2151da", "error": "#ba1a1a", "on-surface-variant": "#434655", "surface-variant": "#d3e4fe", "tertiary-fixed": "#95f8a7" }, "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, "spacing": { "margin": "1rem", "space-md": "1rem", "margin-md": "1.5rem", "space-xs": "0.25rem", "space-lg": "1.5rem", "gutter-lg": "1.5rem", "margin-lg": "2rem", "gutter": "1rem", "space-xl": "2rem", "space-sm": "0.5rem", "space-xxl": "3rem" }, "fontFamily": { "headline-sm": ["Inter"], "label-sm": ["Inter"], "label-lg": ["Inter"], "body-sm": ["Inter"], "headline-lg": ["Inter"], "label-md": ["Inter"], "headline-lg-mobile": ["Inter"], "body-md": ["Inter"], "headline-md": ["Inter"], "display": ["Inter"], "display-mobile": ["Inter"], "title-md": ["Inter"], "body-lg": ["Inter"] }, "fontSize": { "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }], "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.03em", "fontWeight": "600" }], "label-lg": ["14px", { "lineHeight": "20px", "fontWeight": "600" }], "body-sm": ["13px", { "lineHeight": "18px", "fontWeight": "400" }], "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }], "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "600" }], "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }], "body-md": ["15px", { "lineHeight": "24px", "fontWeight": "400" }], "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }], "display": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }], "display-mobile": ["30px", { "lineHeight": "38px", "letterSpacing": "-0.01em", "fontWeight": "700" }], "title-md": ["16px", { "lineHeight": "24px", "fontWeight": "600" }], "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }] } } } };
        </script>
    </head>

    <body class="bg-surface font-body-md text-body-md text-on-surface antialiased min-h-screen flex flex-col">
        <header class="sticky top-0 z-50 bg-surface-container-lowest border-b border-outline-variant shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
            <div class="h-16 max-w-7xl mx-auto px-margin lg:px-margin-lg flex items-center justify-between gap-space-md">
                <div class="flex items-center gap-space-xl">
                    <a class="flex items-center gap-space-sm group" asp-controller="Posts" asp-action="Index">
                        <div class="w-10 h-10 rounded-lg bg-primary-container flex items-center justify-center text-on-primary">
                            <span class="material-symbols-outlined text-[24px]">find_replace</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-headline-sm text-headline-sm tracking-tight text-primary-container leading-none">CampusLost</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant leading-none mt-1">Đại học & Ký túc xá</span>
                        </div>
                    </a>
                    <nav class="hidden md:flex items-center gap-space-lg h-16" data-active-classes="text-primary-container font-label-lg font-bold border-b-2 border-primary-container">
                        <a class="text-on-surface-variant font-label-lg text-label-lg hover:text-on-surface transition-colors flex items-center h-full px-space-xs" asp-controller="Posts" asp-action="Index">Danh sách tin</a>
                    </nav>
                </div>
                <div class="flex items-center gap-space-md">
                    <a class="inline-flex items-center gap-space-xs px-space-md py-space-sm bg-primary-container text-on-primary rounded-lg font-label-lg text-label-lg hover:bg-primary transition-colors shadow-sm" asp-controller="Posts" asp-action="Create">
                        <span class="material-symbols-outlined text-[20px]">add_circle</span>
                        <span>+ Đăng tin</span>
                    </a>
                    <div class="relative flex items-center gap-space-sm pl-space-sm">
                        <button class="flex items-center gap-space-sm rounded-full p-0.5 hover:ring-2 hover:ring-primary-container/20 transition-all focus:outline-none" type="button">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                                <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                            </div>
                            <span class="hidden xl:block font-label-lg text-label-lg text-on-surface">Sinh viên</span>
                            <span class="material-symbols-outlined text-on-surface-variant text-[18px]">arrow_drop_down</span>
                        </button>
                    </div>
                </div>
            </div>
        </header>
        <main class="w-full flex-1 max-w-7xl mx-auto px-margin lg:px-margin-lg py-space-lg bg-surface">
            <div class="flex flex-col w-full">
                <!-- Breadcrumb & Top Navigation Bar -->
                <div class="flex flex-wrap items-center justify-between gap-space-sm mb-space-lg">
                    <nav class="flex items-center gap-space-xs font-body-sm text-body-sm text-on-surface-variant">
                        <a class="hover:text-primary transition-colors flex items-center gap-1" asp-controller="Posts" asp-action="Index">
                            <span class="material-symbols-outlined text-[16px]">home</span>
                            <span>Trang chủ</span>
                        </a>
                        <span class="text-outline">/</span>
                        <a class="hover:text-primary transition-colors" asp-controller="Posts" asp-action="Index">Danh sách tin</a>
                        <span class="text-outline">/</span>
                        <span class="text-on-surface font-title-md text-body-sm truncate max-w-xs">Chi tiết: @Model.Title</span>
                    </nav>
                    <a class="inline-flex items-center gap-space-xs text-primary hover:text-primary-container font-label-lg text-label-lg transition-colors group" asp-controller="Posts" asp-action="Index">
                        <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-0.5 transition-transform">arrow_back</span>
                        <span>Quay về danh sách</span>
                    </a>
                </div>
                <!-- 2-Column Responsive Layout -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
                    <!-- LEFT COLUMN (col-lg-8): Item Overview, Gallery & Full Description -->
                    <div class="lg:col-span-8 flex flex-col gap-space-lg">
                        <!-- Main Header Card -->
                        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
                            <!-- Status Badges & Identifier -->
                            <div class="flex flex-wrap items-center justify-between gap-space-sm pb-space-sm">
                                <div class="flex flex-wrap items-center gap-space-sm">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tertiary-container/15 text-tertiary font-label-lg text-label-md">
                                        <span class="w-2 h-2 rounded-full bg-tertiary">
                                        </span>
                                        @(Model.Kind == 1 ? "Bị mất" : "Nhặt được")
                                    </span>
                                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md">
                                        <span class="material-symbols-outlined text-[15px]">category</span>
                                        Đồ dùng cá nhân
                                    </span>
                                </div>
                                <div class="flex items-center gap-1 text-on-surface-variant font-label-md text-label-md bg-surface-container-low px-2.5 py-1 rounded-lg">
                                    <span>Mã tin:</span>
                                    <span class="font-title-md text-on-surface">#@Model.Id</span>
                                </div>
                            </div>
                            <!-- Primary Item Heading -->
                            <div class="flex flex-col gap-1">
                                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">@Model.Title</h1>
                                <p class="font-body-sm text-body-sm text-on-surface-variant">@Model.Location</p>
                            </div>
                            <!-- Quick Info Metrics Row -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-space-sm pt-space-xs">
                                <div class="bg-surface-container-low p-space-md rounded-xl flex items-start gap-space-sm">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container-highest text-primary flex items-center justify-center flex-shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">location_on</span>
                                    </div>
                                    <div class="flex flex-col min-w-0">
                                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Địa điểm</span>
                                        <span class="font-title-md text-title-md text-on-surface truncate">@Model.Location</span>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant">Địa điểm ghi nhận trong tin</span>
                                    </div>
                                </div>
                                <div class="bg-surface-container-low p-space-md rounded-xl flex items-start gap-space-sm">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container-highest text-primary flex items-center justify-center flex-shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">schedule</span>
                                    </div>
                                    <div class="flex flex-col min-w-0">
                                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Thời gian tiếp nhận</span>
                                        <span class="font-title-md text-title-md text-on-surface">@postedOnVietnam.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant">@postedOnVietnam.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    </div>
                                </div>
                                <div class="bg-surface-container-low p-space-md rounded-xl flex items-start gap-space-sm">
                                    <div class="w-10 h-10 rounded-lg bg-tertiary-container/20 text-tertiary flex items-center justify-center flex-shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">verified</span>
                                    </div>
                                    <div class="flex flex-col min-w-0">
                                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Hiện trạng đồ</span>
                                        <span class="font-title-md text-title-md text-tertiary">@(Model.Kind == 1 ? "Đang tìm kiếm" : "Đã nhặt được")</span>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant truncate">@Model.Location</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Item Image Showcase -->
                        <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-md">
                            <div class="relative w-full h-[360px] md:h-[440px] rounded-lg overflow-hidden bg-surface-container flex items-center justify-center group">
                                <span class="material-symbols-outlined text-[96px] text-outline">inventory_2</span>
                                <div class="absolute bottom-3 left-3 bg-inverse-surface/85 backdrop-blur-sm text-inverse-on-surface px-3 py-1.5 rounded-lg flex items-center gap-2 font-label-sm text-label-sm">
                                    <span class="material-symbols-outlined text-[16px]">photo_camera</span>
                                    <span>Chưa có ảnh đính kèm</span>
                                </div>
                                <div class="absolute top-3 right-3 bg-surface-container-lowest/90 backdrop-blur-sm text-on-surface px-2.5 py-1 rounded-full shadow-sm font-label-sm text-label-sm flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[15px] text-tertiary">check_circle</span>
                                    <span>Thông tin đồ vật</span>
                                </div>
                            </div>
                            <div class="flex items-center justify-between text-on-surface-variant font-body-sm text-body-sm px-space-xs">
                                <span>@Model.Title</span>
                                <span class="text-primary font-label-md text-label-md flex items-center gap-1 cursor-pointer hover:underline">
                                    <span class="material-symbols-outlined text-[16px]">zoom_in</span>
                                    Chưa có ảnh
                                </span>
                            </div>
                        </div>
                        <!-- Detailed Description Section -->
                        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
                            <div class="flex items-center gap-space-sm">
                                <div class="w-2 h-6 rounded-full bg-primary-container">
                                </div>
                                <h2 class="font-headline-sm text-headline-sm text-on-surface">Mô tả chi tiết</h2>
                            </div>
                            <div class="bg-surface-container-low rounded-xl p-space-md flex flex-col gap-space-sm">
                                <span class="font-label-lg text-label-lg text-on-surface">Nội dung ghi nhận từ người bàn giao:</span>
                                <p class="font-body-md text-body-md text-on-surface leading-relaxed whitespace-pre-line">@Model.Description</p>
                            </div>
                            <!-- Campus Desk Verification Note -->
                            <div class="bg-surface-container p-space-md rounded-xl flex items-start gap-space-md">
                                <div class="w-9 h-9 rounded-lg bg-primary-container text-on-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <span class="material-symbols-outlined text-[20px]">inventory_2</span>
                                </div>
                                <div class="flex flex-col gap-1 text-on-surface">
                                    <span class="font-title-md text-title-md">Hướng dẫn xác minh:</span>
                                    <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">Liên hệ người đăng và cung cấp đặc điểm nhận dạng riêng của đồ vật để đối chiếu trước khi trao trả.</p>
                                    <div class="flex items-center gap-2 mt-2 font-label-sm text-label-sm text-on-surface-variant">
                                        <span class="material-symbols-outlined text-[15px] text-tertiary">task_alt</span>
                                        <span>Vui lòng xác minh thông tin trước khi nhận đồ</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- RIGHT COLUMN (col-lg-4): Verification & Contact Callout -->
                    <div class="lg:col-span-4 flex flex-col gap-space-lg">
                        <!-- Main Contact & Claim Action Box -->
                        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-md flex flex-col gap-space-md">
                            <div class="flex items-start justify-between gap-space-sm">
                                <div>
                                    <span class="font-label-sm text-label-sm text-primary uppercase font-bold tracking-wider">Hỗ trợ nhận diện</span>
                                    <h2 class="font-headline-sm text-headline-sm text-on-surface mt-0.5">Thông tin liên hệ & Nhận lại</h2>
                                </div>
                                <div class="w-10 h-10 rounded-full bg-primary-container/10 text-primary-container flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-outlined text-[22px]">support_agent</span>
                                </div>
                            </div>
                            <div class="bg-surface-container-low rounded-xl p-space-md flex flex-col gap-space-xs">
                                <span class="font-label-sm text-label-sm text-on-surface-variant">Địa điểm ghi nhận:</span>
                                <span class="font-title-md text-title-md text-on-surface flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-primary text-[18px]">local_library</span>
                                    @Model.Location
                                </span>
                                <span class="font-body-sm text-body-sm text-on-surface-variant mt-1">Thời gian trao trả do hai bên thống nhất</span>
                            </div>
                            <!-- Email Contact Box with Copy Utility -->
                            <div class="flex flex-col gap-1.5">
                                <label class="font-label-sm text-label-sm text-on-surface-variant font-medium">Thông tin liên hệ:</label>
                                <div class="flex items-center justify-between bg-surface-container-low px-space-md py-2.5 rounded-lg">
                                    <div class="flex items-center gap-2 overflow-hidden">
                                        <span class="material-symbols-outlined text-primary text-[18px]">mail</span>
                                        <span class="font-title-md text-body-md text-on-surface select-all truncate" id="contactEmail">@Model.Contact</span>
                                    </div>
                                    <button class="flex-shrink-0 text-primary hover:text-primary-container font-label-md text-label-md px-2.5 py-1 rounded bg-surface-container-lowest hover:bg-surface-container transition-colors flex items-center gap-1 shadow-sm" id="copyBtn" onclick="copyEmailToClipboard()" title="Sao chép địa chỉ email">
                                        <span class="material-symbols-outlined text-[16px]" id="copyIcon">content_copy</span>
                                        <span id="copyText">Sao chép</span>
                                    </button>
                                </div>
                            </div>
                            <!-- Action CTA Button -->
                            <a class="w-full h-11 bg-primary-container text-on-primary rounded-lg font-label-lg text-label-lg flex items-center justify-center gap-2 hover:bg-primary transition-all shadow-sm active:scale-[0.99]" href="@(Model.Contact.Contains('@') ? "mailto:" + Model.Contact : "tel:" + Model.Contact)">
                                <span class="material-symbols-outlined text-[20px]">send</span>
                                <span>Liên hệ ngay</span>
                            </a>
                            <div class="flex items-center justify-center gap-2 text-center text-on-surface-variant font-body-sm text-body-sm pt-1">
                                <span class="material-symbols-outlined text-[16px] text-tertiary">check</span>
                                <span>Liên hệ trực tiếp người đăng để trao đổi</span>
                            </div>
                            <!-- Essential Verification Guidelines (Lưu ý) -->
                            <div class="bg-secondary-fixed/30 rounded-xl p-space-md flex flex-col gap-space-xs text-on-secondary-fixed">
                                <div class="flex items-center gap-1.5 font-label-lg text-label-lg text-secondary">
                                    <span class="material-symbols-outlined text-[18px]">gavel</span>
                                    <span>Lưu ý khi đến nhận đồ:</span>
                                </div>
                                <p class="font-body-sm text-body-sm text-on-secondary-fixed-variant leading-relaxed">
                                    Vui lòng mang theo
                                    <strong>Thẻ sinh viên chính chủ</strong>
                                    và mô tả đặc điểm riêng (dung tích, nhãn hiệu hoặc vết trầy xước) để đối chiếu trước khi nhận bàn giao.
                                </p>
                            </div>
                        </div>
                        <!-- Quick Action Secondary Link -->
                        <div class="pt-space-xs">
                            <a class="w-full h-11 bg-surface-container text-on-surface hover:bg-surface-container-high rounded-lg font-label-lg text-label-lg flex items-center justify-center gap-space-xs transition-colors shadow-sm" asp-controller="Posts" asp-action="Index">
                                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                                <span>Quay về danh sách</span>
                            </a>
                        </div>
                    </div>
                </div>
                <script>
                    function copyEmailToClipboard() {
                      const email = document.getElementById('contactEmail').innerText.trim();
                      navigator.clipboard.writeText(email).then(() => {
                        const copyText = document.getElementById('copyText');
                        const copyIcon = document.getElementById('copyIcon');

                        copyText.innerText = 'Đã chép!';
                        copyIcon.innerText = 'check';
                        copyText.classList.add('text-tertiary');
                        copyIcon.classList.add('text-tertiary');

                        setTimeout(() => {
                          copyText.innerText = 'Sao chép';
                          copyIcon.innerText = 'content_copy';
                          copyText.classList.remove('text-tertiary');
                          copyIcon.classList.remove('text-tertiary');
                        }, 2200);
                      }).catch(err => {
                        console.error('Không thể sao chép văn bản: ', err);
                      });
                    }
                </script>
            </div>
        </main>
        <footer class="w-full bg-surface-container-lowest border-t border-outline-variant mt-auto">
            <div class="max-w-7xl mx-auto px-margin lg:px-margin-lg py-space-xl">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-space-xl">
                    <div class="md:col-span-2 flex flex-col gap-space-sm">
                        <div class="flex items-center gap-space-sm">
                            <div class="w-8 h-8 rounded-lg bg-primary-container flex items-center justify-center text-on-primary">
                                <span class="material-symbols-outlined text-[18px]">school</span>
                            </div>
                            <span class="font-title-md text-title-md text-on-surface">CampusLost Portal</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant max-w-md">Cổng thông tin tiếp nhận, quản lý và xác minh đồ thất lạc dành cho toàn thể sinh viên, giảng viên và cán bộ trong khuôn viên nhà trường.</p>
                        <div class="flex items-center gap-space-xs text-on-surface-variant font-label-sm text-label-sm mt-space-sm">
                            <span class="material-symbols-outlined text-[16px]">location_on</span>
