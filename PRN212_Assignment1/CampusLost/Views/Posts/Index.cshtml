@model IReadOnlyList<LostItemPost>
@{
    Layout = null;
    var postsUrl = Url.Content("~/Posts");
    var searchQuery = ViewData["SearchQuery"] as string;
    var selectedKind = ViewData["SelectedKind"] as int?;
    var hasResults = Model.Count > 0;
}
<!DOCTYPE html>

<html lang="vi">
    <head>
        <meta charset="utf-8"/>
        <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
        <meta content="web_standard" name="shell-type"/>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet"/>
        <style>
            @@layer
            base {

                html,
                body {
                    margin: 0;
                    padding: 0;
                }

                body {
                    overscroll-behavior: none;
                }

                main> :first-child {
                    margin-top: 0 !important;
                }

                main> :last-child {
                    margin-bottom: 0 !important;
                }
            }

            ::-webkit-scrollbar {
                display: none;
            }

            #lostFoundTable[hidden], #tableFooter[hidden], #emptyState[hidden] {
                display: none;
            }
        </style>
        <script src="https://cdn.tailwindcss.com"></script>
        <script id="tailwind-config">
            tailwind.config = { darkMode: "class", theme: { extend: { "colors": { "surface-container-highest": "#d3e4fe", "on-primary-fixed": "#001551", "surface-bright": "#f8f9ff", "on-primary": "#ffffff", "primary": "#0037b0", "on-error-container": "#93000a", "secondary-fixed": "#ffdbd0", "on-tertiary-fixed-variant": "#005323", "on-tertiary-container": "#88ea9a", "tertiary-container": "#006b2f", "on-surface": "#0b1c30", "primary-fixed": "#dce1ff", "on-tertiary": "#ffffff", "surface-dim": "#cbdbf5", "primary-fixed-dim": "#b7c4ff", "error-container": "#ffdad6", "outline": "#747686", "on-secondary-fixed-variant": "#832600", "primary-container": "#1d4ed8", "secondary-container": "#fd6b36", "tertiary-fixed-dim": "#79db8d", "tertiary": "#005022", "surface-container-low": "#eff4ff", "on-background": "#0b1c30", "surface-container-high": "#dce9ff", "on-secondary-fixed": "#390c00", "secondary-fixed-dim": "#ffb59d", "on-error": "#ffffff", "background": "#f8f9ff", "on-secondary-container": "#5d1900", "surface-container": "#e5eeff", "inverse-on-surface": "#eaf1ff", "inverse-surface": "#213145", "on-primary-container": "#cad3ff", "inverse-primary": "#b7c4ff", "secondary": "#ac3400", "on-tertiary-fixed": "#00210a", "surface": "#f8f9ff", "outline-variant": "#c4c5d7", "on-primary-fixed-variant": "#0039b5", "surface-container-lowest": "#ffffff", "on-secondary": "#ffffff", "surface-tint": "#2151da", "error": "#ba1a1a", "on-surface-variant": "#434655", "surface-variant": "#d3e4fe", "tertiary-fixed": "#95f8a7" }, "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, "spacing": { "margin": "1rem", "space-md": "1rem", "margin-md": "1.5rem", "space-xs": "0.25rem", "space-lg": "1.5rem", "gutter-lg": "1.5rem", "margin-lg": "2rem", "gutter": "1rem", "space-xl": "2rem", "space-sm": "0.5rem", "space-xxl": "3rem" }, "fontFamily": { "headline-sm": ["Inter"], "label-sm": ["Inter"], "label-lg": ["Inter"], "body-sm": ["Inter"], "headline-lg": ["Inter"], "label-md": ["Inter"], "headline-lg-mobile": ["Inter"], "body-md": ["Inter"], "headline-md": ["Inter"], "display": ["Inter"], "display-mobile": ["Inter"], "title-md": ["Inter"], "body-lg": ["Inter"] }, "fontSize": { "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }], "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.03em", "fontWeight": "600" }], "label-lg": ["14px", { "lineHeight": "20px", "fontWeight": "600" }], "body-sm": ["13px", { "lineHeight": "18px", "fontWeight": "400" }], "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }], "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "600" }], "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }], "body-md": ["15px", { "lineHeight": "24px", "fontWeight": "400" }], "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }], "display": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }], "display-mobile": ["30px", { "lineHeight": "38px", "letterSpacing": "-0.01em", "fontWeight": "700" }], "title-md": ["16px", { "lineHeight": "24px", "fontWeight": "600" }], "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }] } } } };
        </script>
    </head>

    <body class="bg-surface font-body-md text-body-md text-on-surface antialiased min-h-screen flex flex-col">
        <header class="sticky top-0 z-50 bg-surface-container-lowest border-b border-outline-variant shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
            <div class="h-16 max-w-7xl mx-auto px-margin lg:px-margin-lg flex items-center justify-between gap-space-md">
                <div class="flex items-center gap-space-xl">
                    <a class="flex items-center gap-space-sm group" asp-controller="Posts" asp-action="Index">
                        <div class="w-10 h-10 rounded-lg bg-primary-container flex items-center justify-center text-on-primary">
                            <span class="material-symbols-outlined text-[24px]">find_replace</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-headline-sm text-headline-sm tracking-tight text-primary-container leading-none">CampusLost</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant leading-none mt-1">Đại học & Ký túc xá</span>
                        </div>
                    </a>
                    <nav class="hidden md:flex items-center gap-space-lg h-16" data-active-classes="text-primary-container font-label-lg font-bold border-b-2 border-primary-container">
                        <a class="text-on-surface-variant font-label-lg text-label-lg hover:text-on-surface transition-colors flex items-center h-full px-space-xs" asp-controller="Posts" asp-action="Index">Danh sách tin</a>
                    </nav>
                </div>
                <div class="flex items-center gap-space-md">
                    <a class="inline-flex items-center gap-space-xs px-space-md py-space-sm bg-primary-container text-on-primary rounded-lg font-label-lg text-label-lg hover:bg-primary transition-colors shadow-sm" asp-controller="Posts" asp-action="Create">
                        <span class="material-symbols-outlined text-[20px]">add_circle</span>
                        <span>+ Đăng tin</span>
                    </a>
                    <div class="relative flex items-center gap-space-sm pl-space-sm">
                        <button class="flex items-center gap-space-sm rounded-full p-0.5 hover:ring-2 hover:ring-primary-container/20 transition-all focus:outline-none" type="button">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                                <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                            </div>
                            <span class="hidden xl:block font-label-lg text-label-lg text-on-surface">Sinh viên</span>
                            <span class="material-symbols-outlined text-on-surface-variant text-[18px]">arrow_drop_down</span>
                        </button>
                    </div>
                </div>
            </div>
        </header>
        <main class="w-full flex-1 max-w-7xl mx-auto px-margin lg:px-margin-lg py-space-lg bg-surface">
            <div class="flex flex-col w-full">
                <!-- Top Breadcrumb & Header Summary -->
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-lg">
                    <div class="flex flex-col gap-space-xs">
                        <nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md">
                            <a class="hover:text-primary-container transition-colors flex items-center gap-1" href="#">
                                <span class="material-symbols-outlined text-[16px]">home</span>
                                <span>Trang chủ</span>
                            </a>
                            <span class="text-outline">/</span>
                            <span class="text-primary font-semibold">Danh sách tin</span>
                        </nav>
                        <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight mt-1">Đồ thất lạc trong trường</h1>
                        <p class="font-body-md text-body-md text-on-surface-variant">Tìm lại đồ đã mất hoặc giúp người khác nhận lại đồ tại khuôn viên giảng đường.</p>
                    </div>
                    <!-- Active Counters & Micro Metrics -->
                    <div class="flex items-center gap-space-sm self-start md:self-auto">
                        <div class="flex items-center gap-space-xs px-space-md py-space-sm bg-surface-container rounded-full text-on-surface shadow-sm">
                            <span class="w-2 h-2 rounded-full bg-tertiary-container animate-pulse">
                            </span>
                            <span class="font-label-lg text-label-lg font-semibold">Tổng cộng:</span>
                            <span class="font-label-lg text-label-lg text-primary-container font-bold px-2 py-0.5 bg-surface-container-lowest rounded-full shadow-xs">@Model.Count tin đang hoạt động</span>
                        </div>
                    </div>
                </div>
                <!-- Filter Card Component -->
                <section class="bg-surface-container-lowest rounded-xl shadow-sm p-space-md lg:p-space-lg mb-space-lg">
                    <form class="grid grid-cols-1 md:grid-cols-12 gap-space-md items-end" id="filterForm" action="@postsUrl" method="get">
                        <!-- Search Input -->
                        <div class="md:col-span-5 flex flex-col gap-space-xs">
                            <label class="font-label-md text-label-md text-on-surface font-semibold flex items-center gap-1" for="search-input">
                                <span class="material-symbols-outlined text-[16px] text-primary-container">search</span>
                                <span>Nhập tên đồ vật</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
                                <input class="w-full h-11 pl-10 pr-space-md bg-surface text-on-surface rounded-lg font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-primary-container/20 focus:bg-surface-container-lowest transition-all" id="search-input" name="q" value="@searchQuery" placeholder="Nhập tên đồ vật cần tìm (ví dụ: thẻ, chìa khóa, tai nghe)..." type="text"/>
                            </div>
                        </div>
                        <!-- Category / Type Dropdown -->
                        <div class="md:col-span-3 flex flex-col gap-space-xs">
                            <label class="font-label-md text-label-md text-on-surface font-semibold flex items-center gap-1" for="type-select">
                                <span class="material-symbols-outlined text-[16px] text-primary-container">tune</span>
                                <span>Loại tin đăng</span>
                            </label>
                            <div class="relative">
                                <select class="w-full h-11 pl-space-md pr-10 bg-surface text-on-surface rounded-lg font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-primary-container/20 focus:bg-surface-container-lowest transition-all appearance-none cursor-pointer" id="type-select" name="kind">
                                    <option value="" selected="@(selectedKind is null)">Tất cả loại tin</option>
                                    <option value="1" selected="@(selectedKind == 1)">Bị mất</option>
                                    <option value="2" selected="@(selectedKind == 2)">Nhặt được</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
                            </div>
                        </div>
                        <!-- Action Buttons -->
                        <div class="md:col-span-4 flex items-center gap-space-sm pt-2 md:pt-0">
                            <button class="flex-1 h-11 inline-flex items-center justify-center gap-space-xs px-space-lg bg-primary-container text-on-primary rounded-lg font-label-lg text-label-lg hover:bg-primary transition-all shadow-sm active:scale-[0.98]" type="submit">
                                <span class="material-symbols-outlined text-[18px]">search</span>
                                <span>Tìm kiếm</span>
                            </button>
                            <a class="h-11 inline-flex items-center justify-center gap-space-xs px-space-md bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg font-label-lg text-label-lg transition-colors cursor-pointer" href="@postsUrl" title="Xóa toàn bộ bộ lọc">
                                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                                <span class="hidden sm:inline">Xóa lọc</span>
                            </a>
                        </div>
                    </form>
                    <!-- Visual Filter Badges / Quick Shortcuts -->
                    <div class="flex flex-wrap items-center gap-space-xs mt-space-md pt-space-sm">
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Gợi ý tìm nhanh:</span>
                        <button class="px-space-sm py-1 bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary-container rounded-full font-label-sm text-label-sm transition-colors" onclick="setQuickSearch('Thẻ sinh viên')" type="button">#Thẻ sinh viên</button>
                        <button class="px-space-sm py-1 bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary-container rounded-full font-label-sm text-label-sm transition-colors" onclick="setQuickSearch('Bình nước')" type="button">#Bình nước</button>
                        <button class="px-space-sm py-1 bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary-container rounded-full font-label-sm text-label-sm transition-colors" onclick="setQuickSearch('Tai nghe')" type="button">#Tai nghe</button>
                        <button class="px-space-sm py-1 bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary-container rounded-full font-label-sm text-label-sm transition-colors" onclick="setQuickSearch('Chìa khóa')" type="button">#Chìa khóa xe</button>
                    </div>
                </section>
                <!-- Main Data Section (Table View) -->
                <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden mb-space-xl">
                    <!-- Table Header Info Bar -->
                    <div class="px-space-lg py-space-md bg-surface-container-low flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
                        <div class="flex items-center gap-space-sm">
                            <span class="font-title-md text-title-md text-on-surface">Danh mục vật phẩm bàn giao & báo mất</span>
                            <span class="px-2 py-0.5 bg-surface-container-highest text-primary-container rounded-md font-label-sm text-label-sm font-bold">Cập nhật thời gian thực</span>
                        </div>
                        <div class="flex items-center gap-space-md font-label-sm text-label-sm text-on-surface-variant">
                            <span class="flex items-center gap-1">
                                <span class="w-2.5 h-2.5 rounded-full bg-[#15803d]">
                                </span>
                                Nhặt được: @Model.Count(p => p.Kind == 2)
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="w-2.5 h-2.5 rounded-full bg-[#c2410c]">
                                </span>
                                Bị mất: @Model.Count(p => p.Kind == 1)
                            </span>
                        </div>
                    </div>
                    <!-- Responsive Table -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left" id="lostFoundTable" hidden="@(!hasResults)">
                            <thead class="bg-surface-container text-on-surface-variant font-label-md text-label-md uppercase tracking-wider select-none">
                                <tr>
                                    <th class="py-3.5 px-space-lg font-bold" scope="col">Tên đồ vật</th>
                                    <th class="py-3.5 px-space-md font-bold text-center" scope="col">Loại tin</th>
                                    <th class="py-3.5 px-space-md font-bold" scope="col">Địa điểm</th>
                                    <th class="py-3.5 px-space-md font-bold" scope="col">Thời gian</th>
                                    <th class="py-3.5 px-space-lg font-bold text-right" scope="col">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y-0" id="tableBody">
                                @foreach (var post in Model)
                                {
                                    var postedOnVietnam = new DateTimeOffset(DateTime.SpecifyKind(post.PostedOn, DateTimeKind.Utc)).ToOffset(TimeSpan.FromHours(7));
                                    <tr class="group hover:bg-surface-container-low transition-colors duration-150">
                                        <td class="py-space-md px-space-lg">
                                            <div class="flex items-center gap-space-md">
                                                <div class="w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center shrink-0 text-primary-container group-hover:scale-105 transition-transform overflow-hidden shadow-xs">
                                                    <span class="material-symbols-outlined text-[24px]">inventory_2</span>
                                                </div>
                                                <div class="flex flex-col min-w-0">
                                                    <a class="font-title-md text-title-md text-primary-container font-semibold hover:text-primary hover:underline truncate" asp-action="Details" asp-route-id="@post.Id">@post.Title</a>
                                                    <span class="font-body-sm text-body-sm text-on-surface-variant truncate">@post.Description</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-space-md px-space-md text-center">
                                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full font-label-md text-label-md font-semibold @(post.Kind == 1 ? "bg-[#ffedd5] text-[#c2410c]" : "bg-[#dcfce7] text-[#15803d]")">
                                                <span class="w-1.5 h-1.5 rounded-full @(post.Kind == 1 ? "bg-[#c2410c]" : "bg-[#15803d]")">
                                                </span>
                                                @(post.Kind == 1 ? "Bị mất" : "Nhặt được")
                                            </span>
                                        </td>
                                        <td class="py-space-md px-space-md">
                                            <div class="inline-flex items-center gap-1.5 text-on-surface font-body-sm text-body-sm">
                                                <span class="material-symbols-outlined text-[18px] text-primary-container shrink-0">local_library</span>
                                                <span class="font-medium">@post.Location</span>
                                            </div>
                                        </td>
                                        <td class="py-space-md px-space-md whitespace-nowrap">
                                            <div class="flex flex-col">
                                                <span class="font-label-lg text-label-lg text-on-surface font-medium">@postedOnVietnam.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                                <span class="font-label-sm text-label-sm text-on-surface-variant">@postedOnVietnam.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                            </div>
                                        </td>
                                        <td class="py-space-md px-space-lg text-right whitespace-nowrap">
                                            <a class="inline-flex items-center gap-1 text-primary-container font-label-lg text-label-lg hover:text-primary font-semibold group/btn" asp-action="Details" asp-route-id="@post.Id">
                                                <span>Xem chi tiết</span>
                                                <span class="material-symbols-outlined text-[18px] group-hover/btn:translate-x-1 transition-transform">arrow_forward</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- Empty State -->
                    <div class="p-space-xxl text-center flex flex-col items-center justify-center" id="emptyState" hidden="@hasResults">
                        <div class="w-20 h-20 rounded-full bg-surface-container flex items-center justify-center mb-space-md text-outline">
                            <span class="material-symbols-outlined text-[42px]">search_off</span>
                        </div>
                        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-space-xs">Không tìm thấy tin phù hợp</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant max-w-md mx-auto mb-space-lg">Rất tiếc, hiện tại không có dữ liệu nào khớp với từ khóa hoặc tiêu chí tìm kiếm của bạn. Hãy thử kiểm tra lại chính tả hoặc xóa bớt bộ lọc.</p>
                        <div class="flex items-center gap-space-md">
                            <a class="inline-flex items-center gap-space-xs px-space-lg py-space-sm bg-surface-container hover:bg-surface-container-high text-primary-container rounded-lg font-label-lg text-label-lg transition-colors shadow-xs" href="@postsUrl">
                                <span class="material-symbols-outlined text-[18px]">refresh</span>
                                <span>Xóa lọc và xem tất cả</span>
                            </a>
                            <a class="inline-flex items-center gap-space-xs px-space-lg py-space-sm bg-primary-container text-on-primary rounded-lg font-label-lg text-label-lg hover:bg-primary transition-colors shadow-sm" asp-controller="Posts" asp-action="Create">
                                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                                <span>Đăng tin tìm đồ</span>
                            </a>
                        </div>
                    </div>
                    <!-- Table Pagination / Footer Meta -->
                    <div class="px-space-lg py-space-md bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-space-md" id="tableFooter" hidden="@(!hasResults)">
                        <p class="font-label-sm text-label-sm text-on-surface-variant">
                            Hiển thị
                            <span class="font-bold text-on-surface">@Model.Count</span>
                            trên tổng số
                            <span class="font-bold text-on-surface">@Model.Count</span>
                            tin đăng
                        </p>
                        <div class="flex items-center gap-space-xs">
                            <button class="w-9 h-9 rounded-lg flex items-center justify-center bg-surface-container-lowest text-outline opacity-50 cursor-not-allowed" disabled="" type="button">
                                <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                            </button>
                            <button class="w-9 h-9 rounded-lg flex items-center justify-center bg-primary-container text-on-primary font-label-md text-label-md font-bold shadow-xs" type="button">1</button>
                            <button class="w-9 h-9 rounded-lg flex items-center justify-center bg-surface-container-lowest text-outline opacity-50 cursor-not-allowed" disabled="" type="button">
                                <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Interactive Information Callout & Empty State Preview Toggle Section -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-space-lg mb-space-lg">
                    <!-- Quick Guidelines Card -->
                    <div class="lg:col-span-2 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-space-sm mb-space-sm">
                                <div class="w-8 h-8 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary-container">
                                    <span class="material-symbols-outlined text-[20px]">verified_user</span>
                                </div>
                                <h2 class="font-title-md text-title-md text-on-surface">Quy định xác minh khi nhận lại đồ dùng</h2>
                            </div>
